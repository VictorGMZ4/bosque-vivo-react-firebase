rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function roleDoc(){return get(/databases/$(database)/documents/roles/$(request.auth.uid)).data;}
  function admin(){return request.auth != null && (exists(/databases/$(database)/documents/roles/$(request.auth.uid)) ? roleDoc().role == 'admin' && roleDoc().get('disabled', false) != true : request.auth.token.get('admin', false) == true);}
  function teacher(){return request.auth != null && exists(/databases/$(database)/documents/roles/$(request.auth.uid)) && roleDoc().role in ['teacher', 'researcher'] && roleDoc().get('disabled', false) != true;}
  function published(id){return get(/databases/$(database)/documents/species/$(id)).data.is_published == true;}
  function owner(data){return request.auth != null && (data.get('created_by', '') == request.auth.uid || data.get('submitted_by', '') == request.auth.uid);}
  function ownsSpecies(id){return teacher() && owner(get(/databases/$(database)/documents/species/$(id)).data);}
  match /species/{id} {allow read: if admin() || resource.data.is_published == true || (teacher() && (resource.data.created_by == request.auth.uid || resource.data.submitted_by == request.auth.uid)); allow write: if false;}
  match /specimens/{id} {allow read: if admin() || published(resource.data.species_id) || ownsSpecies(resource.data.species_id); allow write: if false;}
  match /photos/{id} {allow read: if admin() || published(resource.data.species_id) || ownsSpecies(resource.data.species_id); allow write: if false;}
  match /roles/{uid} {allow read: if request.auth != null && (request.auth.uid == uid || admin()); allow write: if false;}
  match /profiles/{uid} {allow read: if request.auth != null && (request.auth.uid == uid || admin()); allow write: if false;}
  match /role_requests/{uid} {allow read: if request.auth != null && (request.auth.uid == uid || admin()); allow write: if false;}
  match /submissions/{id} {allow read: if request.auth != null && (admin() || resource.data.owner_id == request.auth.uid || (teacher() && resource.data.status != 'draft')); allow write: if false;}
  match /{document=**} {allow read, write: if false;}
 }
}
